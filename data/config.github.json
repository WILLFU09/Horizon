{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "traffic-radar",
    "profile_settings": {
      "traffic-radar": {
        "threshold": 5.0,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 20,
      "min_score": 250,
      "profile": "traffic-radar"
    },
    "rss": [
      {
        "name": "Google News 科技",
        "url": "https://news.google.com/rss/headlines/section/topic/TECHNOLOGY?hl=zh-CN&gl=CN&ceid=CN:zh-Hans",
        "enabled": true,
        "category": "tech",
        "profile": "traffic-radar",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Google News 财经",
        "url": "https://news.google.com/rss/headlines/section/topic/BUSINESS?hl=zh-CN&gl=CN&ceid=CN:zh-Hans",
        "enabled": true,
        "category": "finance",
        "profile": "traffic-radar",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Google News 国际",
        "url": "https://news.google.com/rss/headlines/section/topic/WORLD?hl=zh-CN&gl=CN&ceid=CN:zh-Hans",
        "enabled": true,
        "category": "politics",
        "profile": "traffic-radar",
        "content_extractor": "trafilatura"
      }
    ]
  },
  "collection": {
    "time_window_hours": 8
  },
  "digest": {
    "max_items": 8,
    "category_groups": {
      "politics": {
        "limit": 4,
        "categories": [
          "politics"
        ]
      },
      "tech": {
        "limit": 3,
        "categories": [
          "tech"
        ]
      },
      "finance": {
        "limit": 1,
        "categories": [
          "finance"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 1,
    "profile_order": [
      "traffic-radar"
    ]
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": ""
  }
}